# Virtualenvs and caches — never belong in a skills repo
.venv/
venv/
__pycache__/
*.pyc
.ai-jail/

# Large binaries. Assessment PDFs/reports must NOT be committed here:
# this repo is public, and assessment work lives on the private homelab remote.
*.pdf
*.zip
*.tar.gz
*.png
*.jpg
*.jpeg

# Credentials — this repo is PUBLIC. fact-check harness outputs and any
# accidental secret material must never be committed.
.env
.env.*
*.key
*.pem
*token*
*secret*
*credential*
.fact-check/

